{
	"name": "movie.surf",
	"description": "A movie recommendation app using AI and TMDB.",
	"author": "Steve Ledsworth",
	"license": "MIT",
	"private": true,
	"homepage": "https://movie.surf",
	"repository": {
		"type": "git",
		"url": "https://github.com/sledsworth/movie.surf.git"
	},
	"keywords": [
		"astro",
		"movie",
		"recommendation",
		"ai",
		"tmdb"
	],
	"type": "module",
	"version": "1.1.0",
	"scripts": {
		"start": "astro dev",
		"build": "astro check && astro build",
		"preview": "astro build && wrangler pages dev dist",
		"deploy": "wrangler pages deploy dist",
		"astro": "astro",
		"check": "astro check && biome check --write",
		"update": "npx npm-check -u",
		"update:astro": "npx @astrojs/upgrade"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^0.110.0",
		"@astrojs/check": "0.9.9",
		"@astrojs/cloudflare": "^12.6.13",
		"@astrojs/mdx": "4.3.14",
		"@google/genai": "^2.11.0",
		"astro": "5.18.2",
		"openai": "6.46.0",
		"typescript": "6.0.3",
		"zod": "3.25.76"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.3",
		"wrangler": "^4.110.0"
	}
}
