---
import { AI_PROVIDER, CLAUDE_MODEL, GEMINI_MODEL, OPENAI_MODEL } from "astro:env/server";

const providers = {
	openai: {
		name: "OpenAI",
		url: "https://openai.com/",
		model: OPENAI_MODEL,
	},
	gemini: {
		name: "Google Gemini",
		url: "https://deepmind.google/technologies/gemini/",
		model: GEMINI_MODEL,
	},
	claude: {
		name: "Anthropic Claude",
		url: "https://anthropic.com/",
		model: CLAUDE_MODEL,
	},
};

const { name, url, model } = providers[AI_PROVIDER] ?? providers.openai;
---

Terrible movie recommendations by <a href={url}>{name}</a>. <span>({model})</span>
<style>
  span {
    font-size: .85rem;
    color: grey;
  }
</style>
